  ],
  "license": "MIT",
  "author": "Ribba B.V. <team@ribba.nl> (https://ribba.nl)",
  "homepage": "https://github.com/RibbaBV/cbr-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RibbaBV/cbr-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/RibbaBV/cbr-mcp/issues"
  },
  "type": "module",
  "bin": {
